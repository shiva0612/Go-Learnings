func consume_channel(ch chan int) {
	for {
		n, ok := <-ch
		//if channel is closed & you dont put this condition it will still continue in the loop with default value 0
		if !ok { 
			break
		}
		fmt.Println("n = ", n)
	}
}
func consume_channel_range(ch chan int) {
	for n := range ch {
		fmt.Println("n = ", n)
	}
}
