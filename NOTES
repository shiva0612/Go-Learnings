// After filling and processing...
Important - this will explain why u need to use a[:0] instead of clear
func main() {
	a := []int{1, 2, 3}
	a = a[:0]
	fmt.Println(a) //[]
	fmt.Println(len(a)) //0
	fmt.Println(cap(a)) //3

	b := []int{1, 2, 3}
	clear(b)
	fmt.Println(b) //[0,0,0]
	fmt.Println(len(b)) //3
	fmt.Println(cap(b)) //3
}


func copying_slices_by_value() {

	a := []int{0, 1}
	b := make([]int, len(a))
	copy(b, a)
	b[0] = 1
	fmt.Println(a) //01
	fmt.Println(b) //11
}


