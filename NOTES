//slog logging

func setup_logger() {
	options := &slog.HandlerOptions{
		Level:     slog.LevelDebug,
		AddSource: true,
		ReplaceAttr: func(groups []string, a slog.Attr) slog.Attr {
			if a.Key == slog.TimeKey {
				return slog.String(slog.TimeKey, a.Value.Time().Format(time.TimeOnly))
			}
			return a
		},
	}
	jsnHandler := slog.NewJSONHandler(os.Stdout, options)
	log := slog.New(jsnHandler)
	slog.SetDefault(log)
}
func main() {
	//setup
	setup_logger()

	//logging
	slog.Info("this is msg")
	slog.Info("this is msg", "key", "value", "key2", "value2")

	type M map[string]any
	slog.Info("printing json",
		"key", M{"name": "shiva", "age": 26},
	)

	jsn, _ := json.Marshal(M{"name": "shiva", "age": 26})
	slog.Info("printing json",
		"key", jsn, //this will print base64 encoded value of json
	)

}

