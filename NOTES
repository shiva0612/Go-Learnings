package main

func main() {
	m := map[int][]byte{}
	for i := range 100 {
		m[i] = make([]byte, 10<<20) //10MB
	}
	//size of the map is
}

type sliceHeader struct {
	Data uintptr // in 64 bit system this pointer is 64 bit = 8 bytes
	Len  int     // in 64 bit system this pointer is 64 bit = 8 bytes
	Cap  int     // in 64 bit system this pointer is 64 bit = 8 bytes
}

/*
so entire slice is of 8+8+8 = 24 bytes
above map has
 	100 * 8 bytes for key (int)      = 800 bytes
    100 * 24 bytes for value ([]byte)= 2400 bytes
	total                            = 3200 bytes

and the actual size is stored in the heap
*/

