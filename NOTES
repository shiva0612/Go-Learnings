func f1() {
	ch := make(chan int, 3)
	ch <- 1
	ch <- 1
	close(ch)
	for range 3 {
		val := <-ch
		fmt.Println(val)
	}
}

func f2() {
	ch := make(chan int, 3)
	ch <- 1
	ch <- 1
	close(ch)
	for range 3 {
		val, ok := <-ch
		if !ok {
			return
		}
		fmt.Println(val)
	}
}

