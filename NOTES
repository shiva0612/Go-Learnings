//file operations 
/*
dont forget this, specify whether to open file in read/write/both -> else you will get bad file descriptor error

os.O_WRONLY: This flag specifies that the file should be opened in write-only mode. It allows writing data to the file but doesn't permit reading from it.
os.O_CREATE: create the file if does not exist
os.O_APPEND: append the new writes at the end
os.O_TRUNC: clear the file content & write fresh
*/
func create_append_file() {
	var err error
	_, err = os.OpenFile("op.go", os.O_WRONLY|os.O_CREATE, 0600)
	if err != nil {
		panic(err)
	}
	_, err = os.OpenFile("op.go", os.O_TRUNC|os.O_WRONLY|os.O_CREATE, 0600) //remove all content & write fresh
	if err != nil {
		panic(err)
	}
	_, err = os.OpenFile("op.go", os.O_APPEND|os.O_WRONLY|os.O_CREATE, 0600) //append the writes
	if err != nil {
		panic(err)
	}
}

