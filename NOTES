//floating point number issue - its every where not just in golang 
package main

import (
	"fmt"
	"math"

	"github.com/shopspring/decimal"
)

func main() {
	simple()
	f1()
	f2()
}

func simple() {
	var a, b float64
	a, b = 0.1, 0.2
	sum := a + b
	fmt.Println(sum)          //0.30000000000000004 -> reason -> decimal numbers are not represented in binary accurately
	fmt.Printf("%.1f\n", sum) //0.3 -> every time you print use this notation
}

func f1() {
	var a, b float64
	a, b = 0.1, 0.2
	result := a + b
	rounded := math.Round(result*10) / 10
	fmt.Println(rounded) // 0.3
}

func f2() {

	a := decimal.NewFromFloat(0.1)
	b := decimal.NewFromFloat(0.2)
	sum := a.Add(b)
	fmt.Println(sum) // 0.3
}

