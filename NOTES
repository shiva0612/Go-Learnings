func select_(ch chan int) {
	select {
	case <-time.After(time.Second):
		fmt.Println("waited for second")
	case ch <- 1: //select not only wait for the channel read, but also waits for the channel write
		fmt.Println("had put values")
	default:
		fmt.Println("default")
	}
	fmt.Println("--select DONE--")

}

------------------------------------------------------------------------------------------------------

//worker pool
func main() {
	wg := &sync.WaitGroup{}
	workers := 10
	jobs := make(chan int, 100)
	results := make(chan int, 100)

	//read from the channel (i.e run the workers)
	for range workers {
		wg.Add(1)
		go work(wg, jobs, results)
	}

	//read from results channel
	doneReading := make(chan struct{})
	go read_results(results, doneReading)

	//put jobs into the channel
	for range 10_000 {
		jobs <- 1
	}
	close(jobs)
	wg.Wait() 
	close(results) //close results after all workers done with the jobs
	<-doneReading  //if we dont have this, right after we close the channel we are exiting main without waiting for draining the results channel
	fmt.Println("main DONE")

}

func work(wg *sync.WaitGroup, jobs, results chan int) {
	defer wg.Done()
	for val := range jobs {
		res := val * val
		results <- res
	}
	//working ...
}

func read_results(results chan int, doneReading chan struct{}) {
	for val := range results {
		_ = val
	}
	doneReading <- struct{}{}
}

------------------------------------------------------------------------------------------------------

func main() {
	wg := &sync.WaitGroup{}
	workers := 10
	jobs := make(chan int, 100)
	results := make(chan int, 100)

	//read from the channel (i.e run the workers)
	for range workers {
		wg.Add(1)
		go work(wg, jobs, results)
	}

	//read from results channel
	readerWg := &sync.WaitGroup{}
	readerWg.Add(1)
	go read_results(results, readerWg)

	//put jobs into the channel
	for range 10_000 {
		jobs <- 1
	}
	close(jobs)
	wg.Wait()
	close(results)  //close results after all workers done with the jobs
	readerWg.Wait() //instead of a signal channel we are using wg bcz we want multiple results reader goroutines 
	fmt.Println("main DONE")

}

func work(wg *sync.WaitGroup, jobs, results chan int) {
	defer wg.Done()
	for val := range jobs {
		res := val * val
		results <- res
	}
	//working ...
}

func read_results(results chan int, readerWg *sync.WaitGroup) {
	defer readerWg.Done()
	for val := range results {
		_ = val
	}
}


