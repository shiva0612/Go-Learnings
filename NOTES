//label break
package main

import "fmt"

func main() {
	matrix := [][]int{
		{1, 2, 3},
		{4, 5, 6},
		{7, 8, 9},
	}

	target := 5

Search:
	for i := range matrix {
		for j := range matrix[i] {
			if matrix[i][j] == target {
				fmt.Printf("Found at [%d][%d]\n", i, j)
				break Search
			}
		}
	}

	fmt.Println("Done")
}
