//http API testing 

func run_gin_server() {
	router := setup()
	log.Fatalln(router.Run(":8087"))
}

func setup() *gin.Engine {
	router := gin.Default()
	router.GET("/", Homegin)
	return router
}
func Homegin(c *gin.Context) {
	c.String(http.StatusOK, "hello from gin")
}

func TestHomegin(t *testing.T) {
	router := setup()

	request, _ := http.NewRequest(http.MethodGet, "/", nil)
	response := httptest.NewRecorder()

	router.ServeHTTP(response, request)

	assert.Equal(t, http.StatusOK, response.Code)
	assert.Equal(t, "hello from gin", response.Body.String())

}

// ------------------
func run_normal_server() {
	http.HandleFunc("/", Homenormal)
	log.Fatalln(http.ListenAndServe(":8081", nil))
}

func Homenormal(w http.ResponseWriter, r *http.Request) {
	w.WriteHeader(http.StatusOK)
	w.Write([]byte("hello from normal"))
}

func TestHomenormal(t *testing.T) {
	request, _ := http.NewRequest(http.MethodGet, "/", nil)
	response := httptest.NewRecorder()

	handler := http.HandlerFunc(Homenormal)
	handler.ServeHTTP(response, request)

	assert.Equal(t, http.StatusOK, response.Code)
	assert.Equal(t, "hello from normal", response.Body.String())

}

