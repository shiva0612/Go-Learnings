
/*
	1bit
	1byte = 8bits
	internets speed 1kbps = 1kilo bits /sec = 1024 bits/sec => 1024/8=128bytes/sec

	1024bits = 1kbits - 10^3 in decimal / binary : 2^10 / 1<<10
	1024*1024bits = 1mbits - 10^6 in decimal / binary : 2^20  / 1<<20
	1024*1024*1024bits = 1gbits - 10^9 in decimal / binary : 2^30 / 1<<30
	1024*1024*1024*1024bits = 1tbits - 10^12 in decimal / binary : 2^40 / 1<<40

	1024bytes = 1kBytes
	1024*1024bytes = 1mBytes
	1024*1024*1024bytes = 1gBytes
	1024*1024*1024*1024bytes = 1tBytes

	from quora ...
	1byte=8bits..
	1 KB=kilo byte=1024bytes=8196 bits.
	1 Kb=kilo bits=1024bits/8 bits=128 bytes.
*/

func representation_bytes() {
	//1<<10 = 1_00000_00000 =  2^10 = 1024

	a := 1 << 10       //1kb
	b := 100 * 1 << 10 //100kb
	c := 1 << 20       //1mb
	d := 100 * 1 << 20 //100mb
	e := 1 << 30       //1gb

	fmt.Println(a, b, c, d, e)
}

func bits_bytes() {
	a := 1024
	b := 1 << 10        //int(1 00000 00000) = 1024 is stored as int
	fmt.Println(a == b) //true
}


func bitwise_op() {
	var a uint = 60 /* 60 = 0011 1100 */
	var b uint = 13 /* 13 = 0000 1101 */
	var c uint = 0

	c = a & b /* 12 = 0000 1100 */
	fmt.Printf("Line 1 - Value of c is %d\n", c)

	c = a | b /* 61 = 0011 1101 */
	fmt.Printf("Line 2 - Value of c is %d\n", c)

	c = a ^ b /* 49 = 0011 0001 */
	fmt.Printf("Line 3 - Value of c is %d\n", c)

	c = a << 2 /* 240 = 1111 0000 */
	//since uint has capacity of 8 bits, extra zeros added to right push left ones out
	fmt.Printf("Line 4 - Value of c is %d\n", c)

	c = a >> 2 /* 15 = 0000 1111 */
	//since uint has capacity of 8 bits, extra zeros added to left push right ones out
	fmt.Printf("Line 5 - Value of c is %d\n", c)
}

--------------------------------------------------------------------------------------------
/*

	int32
	Maximum value (2^31 - 1) in binary: 01111111 11111111 11111111 11111111 (first bit is sign bit)
	Minimum value (-2^31) in binary:  - 10000000 00000000 00000000 00000000 (no sign bit)

	while storing positive value max you store is 2^31 - 1
	here the first bit is 0
	now why do u want to waste first bit again for negative number hence we take that into value instead of sign bit
	min number is -2^31
	---
	uint32
	Minimum value (0)
	Maximum value (2^32 - 1) in binary: 11111111 11111111 11111111 11111111

*/

--------------------------------------------------------------------------------------------
var a int // in 32 bit system is 32/8 = 4 bytes 
var a int // in 64 bit system is 64/8 = 8 bytes 

What "64-bit system" actually means for pointers

When we call a system "64-bit," the most relevant thing for this discussion is: the native word size is 64 bits,
and memory addresses are 64 bits wide.
A pointer's entire job is to hold a memory address — so a pointer's size is tied directly to how many bits the system uses to address memory.

64-bit system → addresses are 64 bits wide → a pointer needs 64 bits to store one → 64 bits = 8 bytes
32-bit system → addresses are 32 bits wide → a pointer needs 32 bits to store one → 32 bits = 4 bytes

var a int32  // ALWAYS 4 bytes, on every platform, period
var b int64  // ALWAYS 8 bytes, on every platform, period
var c int8   // ALWAYS 1 byte

var d int      // 8 bytes on 64-bit systems, 4 bytes on 32-bit systems
var e uint     // 8 bytes on 64-bit systems, 4 bytes on 32-bit systems
var f uintptr  // 8 bytes on 64-bit systems, 4 bytes on 32-bit systems


