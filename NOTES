// SEMAPHORE : limiting number of go-routines
// max go-routines
func main() {
	maxGoroutines := 10
	rateLimit := make(chan struct{}, maxGoroutines)
	for i := 0; i < 100; i++ {
		rateLimit <- struct{}{}
		go func(i int) {
			defer func() { <-rateLimit }()
			// Simulate work
		}(i)
	}
}

// max go-routines using errgroup
func main() {
	eg := &errgroup.Group{}
	eg.SetLimit(100) //this will ensure that at any point only 100 routines are present
	for range 10_000 {
		eg.Go(func() error {
			return nil
		})
	}
	//waits for all routines to be completed even if one results into error (it does not panic)
	//returns the first error observed in go-routines
	err := eg.Wait()
	if err != nil {
		fmt.Println("error: ", err.Error())
	}
}

// V. V. IMP : 
g := &errgroup.Group{} //if one go-routine throws error, it will allow other go-routines to complete and & return the first error seen

------------------------------------------------------------------------------------------------------

func main() {
	ctx := context.Background()

	g, ctx := errgroup.WithContext(ctx) //this is used to cancel all go-routines if one fails, but only if ctx is handled 

	//here ctx.Done() is not handled - so keeps running if task 2 fails
	g.Go(func() error {
		fmt.Println("Task 1 started")

		time.Sleep(10 * time.Second)

		fmt.Println("Task 1 finished")
		return nil
	})

	g.Go(func() error {
		fmt.Println("Task 2 started")

		time.Sleep(1 * time.Second)

		fmt.Println("Task 2 failed")
		return fmt.Errorf("task 2 failed")
	})

	//this is checking ctx, so its return once task 2 fails
	g.Go(func() error {
		fmt.Println("Task 3 started")

		for {
			select {
			case <-ctx.Done():
				fmt.Println("Task 3 stopping")
				return ctx.Err()

			case <-time.After(500 * time.Millisecond):
				fmt.Println("Task 3 working...")
			}
		}
	})

	err := g.Wait()

	fmt.Println("Error:", err)
}

